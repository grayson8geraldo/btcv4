//@version=5
strategy("BTC VP+CVD+Absorption Strategy", overlay=true,
     initial_capital=10000, default_qty_type=strategy.percent_of_equity,
     default_qty_value=10, commission_type=strategy.commission.percent,
     commission_value=0.04, slippage=2, pyramiding=0,
     calc_on_every_tick=false, process_orders_on_close=true,
     max_lines_count=500, max_labels_count=500)

// =====================================================================
// Strategy version of BTC Volume Profile + CVD + Absorption
// Anti-overfit notes:
//   - process_orders_on_close=true, calc_on_every_tick=false (no intrabar peeking)
//   - lookahead_off everywhere
//   - All session levels are based on the PREVIOUS closed session only
//   - Default params are generic; do NOT optimize per-period
//   - Includes commission + slippage to avoid unrealistic backtests
//   - Use TradingView "Deep Backtesting" date range to split in/out-of-sample
// =====================================================================

// ---------- Inputs ----------
grpVP   = "Volume Profile"
vaPct   = input.float(70.0, "Value Area %", minval=50, maxval=95, step=1, group=grpVP) / 100.0
bins    = input.int(50, "Profile Bins", minval=20, maxval=200, group=grpVP)
sessRes = input.timeframe("D", "Session Timeframe", group=grpVP)
ltfRes  = input.timeframe("5", "Intra-session LTF", group=grpVP)

grpCVD  = "CVD / Absorption"
absorbK = input.float(1.3, "Absorption volume multiplier (vs SMA20)", minval=1.0, step=0.1, group=grpCVD)
divLook = input.int(5,    "Divergence lookback", minval=2, group=grpCVD)
levTol  = input.float(0.15, "Level tolerance %", minval=0.01, step=0.01, group=grpCVD) / 100.0
biasN   = input.int(3, "Bias lookback (sessions)", minval=2, maxval=10, group=grpCVD)

grpRR   = "Risk / Reward / Trail"
atrLen  = input.int(14, "ATR length", minval=2, group=grpRR)
slBuf   = input.float(0.25, "SL buffer (ATR)", minval=0.0, step=0.05, group=grpRR)
rrMult  = input.float(2.0,  "TP R:R", minval=0.5, step=0.1, group=grpRR)
useTrail= input.bool(true,  "Trailing stop за свинг (имитация переноса за дисбаланс)", group=grpRR)
swingN  = input.int(3, "Swing length for trailing", minval=1, group=grpRR)

grpDate = "Backtest window"
useDate = input.bool(false, "Limit by date", group=grpDate)
dStart  = input.time(timestamp("2024-01-01"), "Start", group=grpDate)
dEnd    = input.time(timestamp("2026-12-31"), "End",   group=grpDate)
inDate  = not useDate or (time >= dStart and time <= dEnd)

// ---------- LTF data ----------
[ltfH, ltfL, ltfV] = request.security_lower_tf(syminfo.tickerid, ltfRes, [high, low, volume])

var float[] curPrices = array.new_float()
var float[] curVols   = array.new_float()

isNewSess = ta.change(time(sessRes)) != 0

var float prevVAH = na
var float prevVAL = na
var float prevPOC = na
var float[] pocHist = array.new_float()

if isNewSess
    n = array.size(curPrices)
    if n > 0
        hiP = array.max(curPrices)
        loP = array.min(curPrices)
        if hiP > loP
            step = (hiP - loP) / bins
            binVol = array.new_float(bins, 0.0)
            for i = 0 to n - 1
                p = array.get(curPrices, i)
                v = array.get(curVols, i)
                idx = int(math.floor((p - loP) / step))
                if idx >= bins
                    idx := bins - 1
                if idx < 0
                    idx := 0
                array.set(binVol, idx, array.get(binVol, idx) + v)
            pocIdx = 0
            pocVol = 0.0
            for i = 0 to bins - 1
                if array.get(binVol, i) > pocVol
                    pocVol := array.get(binVol, i)
                    pocIdx := i
            totalVol = array.sum(binVol)
            target = totalVol * vaPct
            accVol = pocVol
            up = pocIdx
            dn = pocIdx
            while accVol < target and (up < bins - 1 or dn > 0)
                upVol = up < bins - 1 ? array.get(binVol, up + 1) : -1.0
                dnVol = dn > 0 ? array.get(binVol, dn - 1) : -1.0
                if upVol >= dnVol
                    up += 1
                    accVol += math.max(upVol, 0.0)
                else
                    dn -= 1
                    accVol += math.max(dnVol, 0.0)
            prevVAH := loP + (up + 1) * step
            prevVAL := loP + dn * step
            prevPOC := loP + (pocIdx + 0.5) * step
            array.unshift(pocHist, prevPOC)
            if array.size(pocHist) > biasN
                array.pop(pocHist)
    array.clear(curPrices)
    array.clear(curVols)

if not na(ltfH)
    sz = array.size(ltfH)
    if sz > 0
        for i = 0 to sz - 1
            h = array.get(ltfH, i)
            l = array.get(ltfL, i)
            v = array.get(ltfV, i)
            if not na(h) and not na(l) and not na(v)
                array.push(curPrices, (h + l) / 2.0)
                array.push(curVols, v)

plot(prevVAH, "Prev VAH", color=color.new(color.red,   0), style=plot.style_linebr)
plot(prevVAL, "Prev VAL", color=color.new(color.green, 0), style=plot.style_linebr)
plot(prevPOC, "Prev POC", color=color.new(color.yellow,0), style=plot.style_linebr)

// ---------- Bias по наклону POC за N сессий ----------
f_biasFromPOC() =>
    int b = 0
    if array.size(pocHist) >= biasN
        bool dn = true
        bool up = true
        for i = 0 to biasN - 2
            cur = array.get(pocHist, i)
            old = array.get(pocHist, i + 1)
            if cur >= old
                dn := false
            if cur <= old
                up := false
        b := dn ? -1 : up ? 1 : 0
    b
bias = f_biasFromPOC()

// ---------- CVD ----------
rng = high - low
buyVol  = rng > 0 ? volume * (close - low)  / rng : volume * 0.5
sellVol = rng > 0 ? volume * (high - close) / rng : volume * 0.5
delta = buyVol - sellVol
var float cvd = 0.0
if isNewSess
    cvd := 0.0
cvd += delta

// ---------- Absorption ----------
volSMA = ta.sma(volume, 20)
highVol = volume > volSMA * absorbK

nearVAH = not na(prevVAH) and math.abs(close - prevVAH) / prevVAH <= levTol
nearVAL = not na(prevVAL) and math.abs(close - prevVAL) / prevVAL <= levTol
nearPOC = not na(prevPOC) and math.abs(close - prevPOC) / prevPOC <= levTol
nearResist = bias == -1 ? (nearVAH or nearPOC or nearVAL) : (nearVAH or nearPOC)
nearSupport= bias ==  1 ? (nearVAL or nearPOC or nearVAH) : (nearVAL or nearPOC)

priceHH = high  >= ta.highest(high,  divLook)[1]
priceLL = low   <= ta.lowest(low,    divLook)[1]
cvdLowerHigh  = cvd < ta.highest(cvd, divLook)[1]
cvdHigherLow  = cvd > ta.lowest(cvd,  divLook)[1]

bearAbsorb = nearResist and highVol and delta > 0 and priceHH and cvdLowerHigh and close < open
bullAbsorb = nearSupport and highVol and delta < 0 and priceLL and cvdHigherLow and close > open

shortSig = bearAbsorb and bias <= 0
longSig  = bullAbsorb and bias >= 0

// ---------- Orders ----------
atr = ta.atr(atrLen)

var float entryPx = na
var float slPx    = na
var float tpPx    = na

if inDate and longSig and strategy.position_size == 0
    entryPx := close
    slPx    := low  - atr * slBuf
    tpPx    := entryPx + (entryPx - slPx) * rrMult
    strategy.entry("L", strategy.long)
    strategy.exit("L-x", from_entry="L", stop=slPx, limit=tpPx)

if inDate and shortSig and strategy.position_size == 0
    entryPx := close
    slPx    := high + atr * slBuf
    tpPx    := entryPx - (slPx - entryPx) * rrMult
    strategy.entry("S", strategy.short)
    strategy.exit("S-x", from_entry="S", stop=slPx, limit=tpPx)

// ---------- Trailing: переносим стоп за свежий свинг (имитация "за зону дисбаланса") ----------
swHi = ta.highest(high, swingN)
swLo = ta.lowest(low,  swingN)

if useTrail and strategy.position_size > 0
    newSL = math.max(slPx, swLo - atr * slBuf)
    if newSL > slPx
        slPx := newSL
        strategy.exit("L-x", from_entry="L", stop=slPx, limit=tpPx)

if useTrail and strategy.position_size < 0
    newSL = math.min(slPx, swHi + atr * slBuf)
    if newSL < slPx
        slPx := newSL
        strategy.exit("S-x", from_entry="S", stop=slPx, limit=tpPx)

// Force flat outside backtest window
if useDate and not inDate and strategy.position_size != 0
    strategy.close_all()

plotshape(shortSig, "S", shape.triangledown, location.abovebar, color.red,   size=size.tiny)
plotshape(longSig,  "L", shape.triangleup,   location.belowbar, color.green, size=size.tiny)
