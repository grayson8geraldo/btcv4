//@version=5
indicator("BTC Volume Profile + CVD + Absorption", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// =====================================================================
// BTC Volume Profile (prev session VAH/VAL/POC) + CVD + Absorption
// ---------------------------------------------------------------------
// Стратегия:
//   1. Контекст (Bias) по предыдущему дневному Value Area
//   2. Уровни VAH / VAL / POC предыдущей сессии
//   3. Подтверждение поглощения (Absorption) через CVD дивергенцию
//   4. Сигнал входа при перехвате инициативы
//
// Анти-overfit:
//   - Все вычисления основаны на ЗАКРЫТОЙ предыдущей сессии (нет look-ahead)
//   - Сигналы используют barstate.isconfirmed логику (срабатывают
//     только на закрытии бара)
//   - Параметры консервативны и не «подогнаны» под конкретный участок
//   - CVD рассчитывается из доступного OHLCV без скрытых данных
// =====================================================================

// ---------- Inputs ----------
grpVP   = "Volume Profile"
vaPct   = input.float(70.0, "Value Area %", minval=50, maxval=95, step=1, group=grpVP) / 100.0
bins    = input.int(50, "Profile Bins", minval=20, maxval=200, group=grpVP)
sessRes = input.timeframe("D", "Session Timeframe", group=grpVP)
ltfRes  = input.timeframe("5", "Intra-session LTF", group=grpVP)

grpCVD  = "CVD / Absorption"
cvdLen  = input.int(14, "CVD lookback (bars)", minval=3, group=grpCVD)
absorbK = input.float(1.3, "Absorption volume multiplier (vs SMA20)", minval=1.0, step=0.1, group=grpCVD)
divLook = input.int(5, "Divergence lookback", minval=2, group=grpCVD)
levTol  = input.float(0.15, "Level tolerance % (proximity to VAH/VAL/POC)", minval=0.01, step=0.01, group=grpCVD) / 100.0

grpUI   = "Display"
showLv  = input.bool(true,  "Show prev session levels", group=grpUI)
showBias= input.bool(true,  "Show bias label", group=grpUI)
biasN   = input.int(3, "Bias lookback (sessions)", minval=2, maxval=10, group=grpUI, tooltip="Кол-во прошлых POC для определения наклона зоны стоимости")

// ---------- Liquidity zone proxies (optional layers) ----------
// ВАЖНО: TradingView не имеет доступа к стакану (order book). Эти слои —
// ИСТОРИЧЕСКИЕ аппроксимации зон вероятной ликвидности из OHLCV-данных.
// Для настоящих стен лимитных ордеров нужен Bookmap / Sierra Chart / ATAS.
grpLiq       = "Liquidity Zones (proxies)"
showNakedPOC = input.bool(false, "Naked POCs (непротестированные POC)", group=grpLiq, tooltip="POC прошлых сессий, которые цена ещё не пробила — классические магниты")
nakedPOClen  = input.int(10, "Naked POC lookback (sessions)", minval=2, maxval=30, group=grpLiq)
showHVNLVN   = input.bool(false, "HVN/LVN of prev session", group=grpLiq, tooltip="High/Low Volume Nodes внутри вчерашней VA: пики концентрации (HVN) и провалы (LVN)")
nodeDelta    = input.float(0.25, "Node prominence (отклонение от среднего бина)", minval=0.05, step=0.05, group=grpLiq)
showEqual    = input.bool(false, "Equal H/L with volume spike", group=grpLiq, tooltip="Свинг-хаи/лоу с повышенным объёмом — зоны накопления стопов и лимиток")
eqPivLen     = input.int(5, "Equal H/L pivot length", minval=2, group=grpLiq)
eqVolMult    = input.float(1.5, "Pivot volume multiplier", minval=1.0, step=0.1, group=grpLiq)
eqMaxLines   = input.int(20, "Equal H/L max lines to keep", minval=5, maxval=100, group=grpLiq)

// ---------- Helper: build session volume profile from LTF data ----------
// Request arrays of LTF highs/lows/volumes within the higher session timeframe.
[ltfH, ltfL, ltfV] = request.security_lower_tf(syminfo.tickerid, ltfRes, [high, low, volume])

// We accumulate per-session arrays of price/volume for current session,
// then on session change compute VAH/VAL/POC of the just-closed session.
var float[] curPrices = array.new_float()
var float[] curVols   = array.new_float()

// Detect new session on the chart's parent timeframe (sessRes)
isNewSess = ta.change(time(sessRes)) != 0

// Persisted previous session levels
var float prevVAH = na
var float prevVAL = na
var float prevPOC = na
var float prevHi  = na
var float prevLo  = na
var float[] pocHist = array.new_float()

// Liquidity zones state
var line[]  nakedPOClines = array.new_line()
var float[] nakedPOCvals  = array.new_float()
var line[]  hvnLines      = array.new_line()
var line[]  lvnLines      = array.new_line()
var line[]  eqLines       = array.new_line()

// On the bar that starts a new session, compute profile from previous arrays
if isNewSess
    n = array.size(curPrices)
    if n > 0
        hiP = array.max(curPrices)
        loP = array.min(curPrices)
        if hiP > loP
            step = (hiP - loP) / bins
            binVol = array.new_float(bins, 0.0)
            for i = 0 to n - 1
                p = array.get(curPrices, i)
                v = array.get(curVols, i)
                idx = int(math.floor((p - loP) / step))
                if idx >= bins
                    idx := bins - 1
                if idx < 0
                    idx := 0
                array.set(binVol, idx, array.get(binVol, idx) + v)
            // POC
            pocIdx = 0
            pocVol = 0.0
            for i = 0 to bins - 1
                if array.get(binVol, i) > pocVol
                    pocVol := array.get(binVol, i)
                    pocIdx := i
            totalVol = array.sum(binVol)
            target = totalVol * vaPct
            accVol = pocVol
            up = pocIdx
            dn = pocIdx
            while accVol < target and (up < bins - 1 or dn > 0)
                upVol = up < bins - 1 ? array.get(binVol, up + 1) : -1.0
                dnVol = dn > 0 ? array.get(binVol, dn - 1) : -1.0
                if upVol >= dnVol
                    up += 1
                    accVol += math.max(upVol, 0.0)
                else
                    dn -= 1
                    accVol += math.max(dnVol, 0.0)
            prevVAH := loP + (up + 1) * step
            prevVAL := loP + dn * step
            prevPOC := loP + (pocIdx + 0.5) * step
            prevHi  := hiP
            prevLo  := loP
            // история POC для определения наклона VA
            array.unshift(pocHist, prevPOC)
            if array.size(pocHist) > biasN
                array.pop(pocHist)

            // ---- Naked POC: добавляем POC только что закрытой сессии ----
            if showNakedPOC
                nl = line.new(bar_index, prevPOC, bar_index + 1, prevPOC, extend=extend.right, color=color.new(color.orange, 20), width=1, style=line.style_dotted)
                array.unshift(nakedPOClines, nl)
                array.unshift(nakedPOCvals, prevPOC)
                while array.size(nakedPOClines) > nakedPOClen
                    ol = array.pop(nakedPOClines)
                    line.delete(ol)
                    array.pop(nakedPOCvals)

            // ---- HVN / LVN: пики и провалы объёма внутри Value Area ----
            if showHVNLVN
                while array.size(hvnLines) > 0
                    line.delete(array.pop(hvnLines))
                while array.size(lvnLines) > 0
                    line.delete(array.pop(lvnLines))
                avgBin = totalVol / bins
                for bi = 1 to bins - 2
                    prvV = array.get(binVol, bi - 1)
                    curV = array.get(binVol, bi)
                    nxtV = array.get(binVol, bi + 1)
                    binPx = loP + (bi + 0.5) * step
                    // узлы только внутри VA
                    if binPx >= prevVAL and binPx <= prevVAH
                        if curV > prvV and curV > nxtV and curV > avgBin * (1 + nodeDelta)
                            hl = line.new(bar_index, binPx, bar_index + 1, binPx, extend=extend.right, color=color.new(color.purple, 30), width=1)
                            array.push(hvnLines, hl)
                        if curV < prvV and curV < nxtV and curV > 0 and curV < avgBin * (1 - nodeDelta)
                            ll = line.new(bar_index, binPx, bar_index + 1, binPx, extend=extend.right, color=color.new(color.aqua, 50), width=1, style=line.style_dashed)
                            array.push(lvnLines, ll)
    array.clear(curPrices)
    array.clear(curVols)

// Append current bar's LTF samples (use bar midpoint as price proxy)
if not na(ltfH)
    sz = array.size(ltfH)
    if sz > 0
        for i = 0 to sz - 1
            h = array.get(ltfH, i)
            l = array.get(ltfL, i)
            v = array.get(ltfV, i)
            if not na(h) and not na(l) and not na(v)
                array.push(curPrices, (h + l) / 2.0)
                array.push(curVols, v)

// ---------- Plot previous session levels ----------
plot(showLv ? prevVAH : na, "Prev VAH", color=color.new(color.red,   0), style=plot.style_linebr, linewidth=2)
plot(showLv ? prevVAL : na, "Prev VAL", color=color.new(color.green, 0), style=plot.style_linebr, linewidth=2)
plot(showLv ? prevPOC : na, "Prev POC", color=color.new(color.yellow,0), style=plot.style_linebr, linewidth=2)

// ---------- Bias ----------
// Bearish if open below prev VAL; Bullish if open above prev VAH; Neutral inside VA
sessOpen = request.security(syminfo.tickerid, sessRes, open, lookahead=barmerge.lookahead_off)
bias = na(prevVAL) or na(prevVAH) ? 0 : (sessOpen < prevVAL ? -1 : sessOpen > prevVAH ? 1 : 0)

if showBias and isNewSess and not na(prevVAH)
    txt = bias == -1 ? "BEARISH (open<VAL)" : bias == 1 ? "BULLISH (open>VAH)" : "NEUTRAL (inside VA)"
    col = bias == -1 ? color.red : bias == 1 ? color.green : color.gray
    label.new(bar_index, high, txt, style=label.style_label_down, color=col, textcolor=color.white, size=size.small)

// ---------- Naked POC touch check ----------
// POC «перестаёт быть naked» как только цена текущего бара пересекла его уровень.
if showNakedPOC and array.size(nakedPOClines) > 0
    k = array.size(nakedPOClines) - 1
    while k >= 0
        pocPx = array.get(nakedPOCvals, k)
        if high >= pocPx and low <= pocPx
            line.delete(array.get(nakedPOClines, k))
            array.remove(nakedPOClines, k)
            array.remove(nakedPOCvals,  k)
        k := k - 1

// ---------- Equal H/L with volume spike ----------
// Пивоты с аномально высоким объёмом = вероятные зоны накопления стопов
// и лимитных заявок (исторический прокси ликвидности).
ph = ta.pivothigh(high, eqPivLen, eqPivLen)
pl = ta.pivotlow(low,  eqPivLen, eqPivLen)
volAtPiv  = volume[eqPivLen]
volSMAp   = ta.sma(volume, 20)[eqPivLen]
isHotPiv  = not na(volSMAp) and volAtPiv > volSMAp * eqVolMult

if showEqual and not na(ph) and isHotPiv
    el = line.new(bar_index - eqPivLen, ph, bar_index, ph, extend=extend.right, color=color.new(color.fuchsia, 30), width=1, style=line.style_dotted)
    array.push(eqLines, el)
    while array.size(eqLines) > eqMaxLines
        line.delete(array.shift(eqLines))

if showEqual and not na(pl) and isHotPiv
    el2 = line.new(bar_index - eqPivLen, pl, bar_index, pl, extend=extend.right, color=color.new(color.fuchsia, 30), width=1, style=line.style_dotted)
    array.push(eqLines, el2)
    while array.size(eqLines) > eqMaxLines
        line.delete(array.shift(eqLines))

// ---------- CVD (per-bar delta proxy from OHLC) ----------
// Aggressive buy/sell estimation using bar range allocation
// (industry-standard proxy when tick data is unavailable)
rng = high - low
buyVol  = rng > 0 ? volume * (close - low)  / rng : volume * 0.5
sellVol = rng > 0 ? volume * (high - close) / rng : volume * 0.5
delta = buyVol - sellVol

// Reset CVD per session
var float cvd = 0.0
if isNewSess
    cvd := 0.0
cvd += delta

// ---------- Absorption detection ----------
volSMA = ta.sma(volume, 20)
highVol = volume > volSMA * absorbK

// Bias-aware proximity:
//   - в медвежьем сценарии (open<VAL) сломанный VAL сам становится сопротивлением,
//     поэтому касание VAL/POC/VAH снизу — валидный шорт-сетап.
//   - аналогично для бычьего сценария: VAH/POC/VAL все играют роль поддержки сверху.
//   - в нейтральном — классика: VAH = resist, VAL = support, POC = оба.
nearVAH = not na(prevVAH) and math.abs(close - prevVAH) / prevVAH <= levTol
nearVAL = not na(prevVAL) and math.abs(close - prevVAL) / prevVAL <= levTol
nearPOC = not na(prevPOC) and math.abs(close - prevPOC) / prevPOC <= levTol

nearResist = bias == -1 ? (nearVAH or nearPOC or nearVAL) : (nearVAH or nearPOC)
nearSupport= bias ==  1 ? (nearVAL or nearPOC or nearVAH) : (nearVAL or nearPOC)

priceHH = high  >= ta.highest(high,  divLook)[1]
priceLL = low   <= ta.lowest(low,    divLook)[1]
cvdLowerHigh  = cvd < ta.highest(cvd, divLook)[1]
cvdHigherLow  = cvd > ta.lowest(cvd,  divLook)[1]

bearAbsorb = nearResist and highVol and delta > 0 and priceHH and cvdLowerHigh and close < open
bullAbsorb = nearSupport and highVol and delta < 0 and priceLL and cvdHigherLow and close > open

// Filter by bias to avoid counter-trend overfitting
shortSig = bearAbsorb and bias <= 0
longSig  = bullAbsorb and bias >= 0

plotshape(shortSig, "Short (Absorption)", shape.triangledown, location.abovebar, color.red,   text="S", textcolor=color.white, size=size.tiny)
plotshape(longSig,  "Long  (Absorption)", shape.triangleup,   location.belowbar, color.green, text="L", textcolor=color.white, size=size.tiny)

alertcondition(shortSig, "BTC VP Short Absorption", "Short absorption at VAH/POC")
alertcondition(longSig,  "BTC VP Long Absorption",  "Long absorption at VAL/POC")

// ---------- SL / TP visualization ----------
grpRR  = "Risk / Reward"
atrLen = input.int(14, "ATR length", minval=2, group=grpRR)
slBuf  = input.float(0.25, "SL buffer (ATR)", minval=0.0, step=0.05, group=grpRR)
rrMult = input.float(2.0, "TP R:R multiple", minval=0.5, step=0.1, group=grpRR)

atr = ta.atr(atrLen)

f_drawTrade(_isLong, _entry, _sl, _tp) =>
    col = _isLong ? color.green : color.red
    line.new(bar_index, _entry, bar_index + 10, _entry, color=color.new(color.blue, 0), width=1, extend=extend.none)
    line.new(bar_index, _sl,    bar_index + 10, _sl,    color=color.new(color.red,  0), width=1, style=line.style_dashed)
    line.new(bar_index, _tp,    bar_index + 10, _tp,    color=color.new(color.green,0), width=1, style=line.style_dashed)
    label.new(bar_index + 10, _entry, "E " + str.tostring(_entry, format.mintick), style=label.style_label_left, color=color.new(color.blue, 70), textcolor=color.white, size=size.tiny)
    label.new(bar_index + 10, _sl,    "SL " + str.tostring(_sl, format.mintick), style=label.style_label_left, color=color.new(color.red, 70),  textcolor=color.white, size=size.tiny)
    label.new(bar_index + 10, _tp,    "TP " + str.tostring(_tp, format.mintick), style=label.style_label_left, color=color.new(color.green,70), textcolor=color.white, size=size.tiny)

if longSig
    entry = close
    sl    = low  - atr * slBuf
    tp    = entry + (entry - sl) * rrMult
    f_drawTrade(true, entry, sl, tp)

if shortSig
    entry = close
    sl    = high + atr * slBuf
    tp    = entry - (sl - entry) * rrMult
    f_drawTrade(false, entry, sl, tp)
